{
  "expo": {
    "name": "ClearCue",
    "slug": "clearcue",
    "version": "1.26.0",
    "orientation": "portrait",
    "icon": "./assets/clearcue-icon.png",
    "splash": {
      "image": "./assets/clearcue-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to protect your ClearCue medication plan."
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.congressionappchallenge.clearcue",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b098a7c8-a84b-4f12-9f41-67c63e292c78"
      }
    },
    "owner": "congression-app-challenge-2026"
  }
}
